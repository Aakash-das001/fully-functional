<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Random Factorization Ladder</title>
    <style>
        :root {
            --line-thickness: 3px;
            --font-size: 32px;
            --prime-color: #d9534f;
        }

        body {
            font-family: 'Georgia', serif;
            background-color: #f4f7f6;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            margin: 0;
        }

        .game-container {
            background: white;
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 550px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

        .header-section {
            margin-bottom: 30px;
        }

        /* --- THE LADDER UI --- */
        .ladder-container {
            display: inline-flex;
            flex-direction: column;
            align-items: flex-start;
            margin-bottom: 20px;
            min-height: 150px;
        }

        .ladder-row {
            display: flex;
            align-items: stretch;
        }

        .divisor-area {
            width: 80px;
            text-align: right;
            padding-right: 15px;
            font-size: var(--font-size);
            font-weight: bold;
            color: var(--prime-color); 
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }

        .quotient-area {
            min-width: 180px;
            text-align: left;
            padding: 8px 20px;
            font-size: var(--font-size);
            font-weight: bold;
            border-left: var(--line-thickness) solid #000;
        }

        .has-line {
            border-bottom: var(--line-thickness) solid #000;
        }

        /* --- INPUT STYLES --- */
        .step-input {
            font-family: 'Georgia', serif;
            font-size: 28px;
            font-weight: bold;
            width: 90px;
            border: 2px solid #ddd;
            border-radius: 6px;
            text-align: center;
            padding: 4px;
            outline: none;
        }

        .divisor-input {
            color: var(--prime-color);
            width: 60px;
        }

        .input-error {
            border-color: #ff4d4d !important;
            background-color: #fff0f0;
        }

        /* --- BUTTONS --- */
        .next-btn {
            background-color: #2c3e50;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 18px;
            border-radius: 8px;
            cursor: pointer;
            margin-bottom: 20px;
            font-weight: bold;
            transition: background 0.2s;
        }

        .next-btn:hover {
            background-color: #1a252f;
        }

        /* --- FINAL RESULT --- */
        .final-area {
            margin-top: 20px;
            padding: 20px;
            background: #e8f5e9;
            border-radius: 10px;
            display: none;
        }

        .final-expr {
            font-size: 28px;
            font-weight: bold;
            color: #2e7d32;
            margin-top: 10px;
        }
    </style>
</head>
<body>

<div class="game-container">
    <div class="header-section">
        <button class="next-btn" id="generateBtn">Generate New Question</button>
        <div id="instruction">Find the prime factors of the number below:</div>
    </div>

    <div id="ladder" class="ladder-container">
    </div>

    <div id="final-area" class="final-area">
        <div style="font-size: 18px;">Factorization Complete!</div>
        <div id="final-expression" class="final-expr"></div>
    </div>
</div>

<script>
    let currentNumber;
    let originalNumber;
    let stepIndex;
    let factors;

    // Add event listener to the button
    document.getElementById('generateBtn').addEventListener('click', function() {
        initGame();
    });

    // Start the game on load
    window.addEventListener('DOMContentLoaded', function() {
        initGame();
    });

    function isPrime(num) {
        if (num < 2) return false;
        for (let i = 2; i <= Math.sqrt(num); i++) {
            if (num % i === 0) return false;
        }
        return true;
    }

    function getRandomComposite() {
        let num;
        do {
            num = Math.floor(Math.random() * 401) + 100; // 100 to 500
        } while (isPrime(num));
        return num;
    }

    function initGame() {
        // Reset Variables
        originalNumber = getRandomComposite();
        currentNumber = originalNumber;
        stepIndex = 0;
        factors = [];
        
        // Reset UI
        document.getElementById('final-area').style.display = 'none';
        const ladder = document.getElementById('ladder');
        ladder.innerHTML = `
            <div class="ladder-row">
                <div class="divisor-area" id="divisor-0">
                    <input type="number" id="input-p-0" class="step-input divisor-input" placeholder="?">
                </div>
                <div class="quotient-area has-line" id="quotient-0">${originalNumber}</div>
            </div>
            <div class="ladder-row" id="row-1">
                <div class="divisor-area" id="divisor-1"></div>
                <div class="quotient-area" id="quotient-1">
                    <input type="number" id="input-q-1" class="step-input" placeholder="?">
                </div>
            </div>
        `;

        setupListeners(0, 1);
        document.getElementById('input-p-0').focus();
    }

    function setupListeners(pIdx, qIdx) {
        const pInp = document.getElementById(`input-p-${pIdx}`);
        const qInp = document.getElementById(`input-q-${qIdx}`);

        const validate = () => {
            const pVal = parseInt(pInp.value);
            const qVal = parseInt(qInp.value);

            // Live validation coloring
            if (!isNaN(pVal)) {
                const isValidP = isPrime(pVal) && currentNumber % pVal === 0;
                pInp.classList.toggle('input-error', !isValidP);
            }

            if (!isNaN(qVal)) {
                const isValidQ = qVal === currentNumber / pVal;
                qInp.classList.toggle('input-error', !isValidQ);
            }

            // Move to next step if both correct
            if (!isNaN(pVal) && !isNaN(qVal) && isPrime(pVal) && qVal === currentNumber / pVal) {
                pInp.disabled = true;
                qInp.disabled = true;
                pInp.style.border = "none";
                qInp.style.background = "transparent";
                
                factors.push(pVal);
                currentNumber = qVal;
                document.getElementById(`quotient-${stepIndex + 1}`).classList.add('has-line');
                
                stepIndex++;

                if (currentNumber === 1) {
                    showFinal();
                } else {
                    addNewRow();
                }
            }
        };

        pInp.addEventListener('input', validate);
        qInp.addEventListener('input', validate);
    }

    function addNewRow() {
        const ladder = document.getElementById('ladder');
        
        // Add prime input to current result row
        const divCell = document.getElementById(`divisor-${stepIndex}`);
        divCell.innerHTML = `<input type="number" id="input-p-${stepIndex}" class="step-input divisor-input" placeholder="?">`;

        // Create new row for next division result
        const nextRow = document.createElement('div');
        nextRow.className = 'ladder-row';
        nextRow.innerHTML = `
            <div class="divisor-area" id="divisor-${stepIndex + 1}"></div>
            <div class="quotient-area" id="quotient-${stepIndex + 1}">
                <input type="number" id="input-q-${stepIndex + 1}" class="step-input" placeholder="?">
            </div>
        `;
        ladder.appendChild(nextRow);

        setupListeners(stepIndex, stepIndex + 1);
        document.getElementById(`input-p-${stepIndex}`).focus();
    }

    function showFinal() {
        document.getElementById(`quotient-${stepIndex}`).classList.remove('has-line');
        document.getElementById('final-area').style.display = 'block';
        document.getElementById('final-expression').innerText = 
            `${originalNumber} = ` + factors.join(' × ');
    }
</script>

</body>
</html>
